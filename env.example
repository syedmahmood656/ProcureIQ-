# Copy to .env and fill in. .env is git-ignored; NEVER commit real keys.
#   PowerShell:  Copy-Item .env.example .env
# Every variable below is read by the code. Blank = use the default / feature off.

# ---- LLM provider (pick one: openrouter | huggingface | gemini | fake) ------------------------
PROCUREIQ_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
HF_TOKEN=

# ---- Postgres (docker compose defaults) -------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=procureiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# optional read-only role for the SQL tool (erp/create_readonly_role.sql)
POSTGRES_RO_USER=
POSTGRES_RO_PASSWORD=

# ---- Qdrant -----------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=            # file-based local Qdrant for demos/tests only

# ---- SQL tool backend (Phase 9) ---------------------------------------------------------------
PROCUREIQ_SQL_BACKEND=local          # local | mcp
# PROCUREIQ_MCP_SQL_URL=http://localhost:8765/mcp
PROCUREIQ_MCP_TIMEOUT_S=

# ---- API (Phase 8) ----------------------------------------------------------------------------
PROCUREIQ_API_KEY=                   # set this before exposing the API anywhere
PROCUREIQ_CACHE_TTL_S=
PROCUREIQ_CACHE_MAX=
PROCUREIQ_MAX_CONCURRENT=
PROCUREIQ_QUEUE_TIMEOUT_S=
PROCUREIQ_FAKE_MODELS=               # 1 = fake embedder/reranker (plumbing tests only)

# ---- Langfuse tracing (Phase 11); blank keys = tracing off -------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=
LANGFUSE_CAPTURE_CONTENT=            # false = redact all text before it leaves your machine

# ---- Managed services (Phase 13b: Neon Postgres + Qdrant Cloud) --------------------------------
# Only needed when you run the API locally against the cloud services. Cloud Run gets these from
# Secret Manager instead (infra/deploy_gcp.ps1).
QDRANT_API_KEY=                      # Qdrant Cloud database API key (blank for local Docker Qdrant)
PGSSLMODE=                           # "require" for Neon (libpq reads this; blank for local Postgres)

# ---- Free public access from your own PC (Phase 13c) -------------------------------------------
# The default Cloudflare tunnel needs nothing. For a PERMANENT URL use a free ngrok account:
# NGROK_AUTHTOKEN=                   # dashboard.ngrok.com > Your Authtoken
# NGROK_DOMAIN=                      # dashboard.ngrok.com > Domains, e.g. my-name.ngrok-free.app
# (infra/go_public.ps1 generates PROCUREIQ_API_KEY for you if it is empty)
